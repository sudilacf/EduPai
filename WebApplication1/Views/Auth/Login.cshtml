@model WebApplication1.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In | EducPai";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-header">
        <h2>Welcome back</h2>
        <p>Sign in to your EducPai account. Students and school staff use the same page.</p>
    </div>

    <form asp-action="Login" method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="error-message"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" autofocus />
            <span asp-validation-for="Email" class="error-text"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <div class="password-input-group">
                <input asp-for="Password" class="form-control" id="loginPassword" placeholder="Enter your password" autocomplete="current-password" />
                <button type="button" class="btn-toggle-pass" aria-pressed="false"
                        onclick="togglePassword('loginPassword', this)">Show</button>
            </div>
            <span asp-validation-for="Password" class="error-text"></span>
        </div>

        <button type="submit" class="btn-primary">Sign In</button>
    </form>

    <div class="auth-footer">
        <p>New student? <a asp-action="Register">Create an account</a></p>
    </div>
</div>
