@model WebApplication1.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Student Registration | EducPai";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <div class="auth-header">
        <h2>Create your account</h2>
        <p>Register as a student to start paying your tuition through EducPai.</p>
    </div>

    <form asp-action="Register" method="post" class="auth-form" novalidate>
        <div asp-validation-summary="ModelOnly" class="error-message"></div>
 
        <div class="form-group">
            <label asp-for="Fullname"></label>
            <input asp-for="Fullname" class="form-control" placeholder="Juan Dela Cruz" autocomplete="name" autofocus />
            <span asp-validation-for="Fullname" class="error-text"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
            <span asp-validation-for="Email" class="error-text"></span>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="SchoolId"></label>
                <select asp-for="SchoolId"
                        asp-items="Model.Schools"
                        class="form-control">
                    <option value="">-- Select your school --</option>
                </select>
                <span asp-validation-for="SchoolId" class="error-text"></span>
            </div>

            <div class="form-group">
                <label asp-for="StudentIdNumber"></label>
                <input asp-for="StudentIdNumber" class="form-control" placeholder="e.g. 2026-12345" />
                <span asp-validation-for="StudentIdNumber" class="error-text"></span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="Password"></label>
                <div class="password-input-group">
                    <input asp-for="Password" class="form-control" id="regPassword" placeholder="Create password" autocomplete="new-password" />
                    <button type="button" class="btn-toggle-pass" aria-pressed="false"
                            onclick="togglePassword('regPassword', this)">Show</button>
                </div>
                <span asp-validation-for="Password" class="error-text"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <div class="password-input-group">
                    <input asp-for="ConfirmPassword" class="form-control" id="regConfirmPassword" placeholder="Repeat password" autocomplete="new-password" />
                    <button type="button" class="btn-toggle-pass" aria-pressed="false"
                            onclick="togglePassword('regConfirmPassword', this)">Show</button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="error-text"></span>
            </div>
        </div>

        <button type="submit" class="btn-primary">Create Account</button>
    </form>

    <div class="auth-footer">
        <p>Already have an account? <a asp-action="Login">Sign in</a></p>
    </div>
</div>
